patch
{
include "materials/models/survivors/survivors_it_shared.vmt"
insert
{
	$basetexture "models/dystopia/survivors/MoonMan/tie_d"
	$bumpmap "models/dystopia/survivors/MoonMan/tie_n"
	$nodecal 1
	$ambientocclusion 1
	$diffuseexp "1.5"

	$phong "1"
	$phongexponent "4"
	$phongboost "2"
	$phongfresnelranges "[0.05 0.15 1.0]"
}
}