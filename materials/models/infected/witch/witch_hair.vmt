VertexLitGeneric
{
$baseTexture "models/fearless/survivors/spirit/witch_hair"

$bumpmap "effects\flat_normal"
$alphatest 1
$allowalphatocoverage 1
$nocull 1
$allowdiffusemodulation 0
$halflambert 1
$phong 1
$phongfresnelranges "[.01 .5 1]"
$basemapluminancephongmask 1
$phongboost 8
$phongexponent 10

"$cloakpassenabled" "1"
"$cloakfactor" "0.97"
"$cloakcolortint" "[0 0 0]"
"$refractamount" "0"


"$nodecal" "1"

Proxies
{
"Sine"
{
"sineperiod" 2
"sinemin" "0"
"sinemax" "0.4"
"timeoffset" "0"
"resultVar" "$cloakcolortint[0]"
}
"Sine"
{
"sineperiod" 2
"sinemin" "0"
"sinemax" "0.4"
"timeoffset" "0"
"resultVar" "$cloakcolortint[1]"
}
"Sine"
{
"sineperiod" 2
"sinemin" "0"
"sinemax" "0.4"
"timeoffset" "0"
"resultVar" "$cloakcolortint[2]"
}
}

}