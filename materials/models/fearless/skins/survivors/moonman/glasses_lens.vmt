patch
{
include "models/fearless/skins/survivors/moonman/survivors_it_shared.vmt"
insert
{
	$basetexture "mactonightfrancis/glasses"
	$color2 "[0.9 0.9 0.9]"
	$nodecal 1
	$nocull 1
	$ambientocclusion 1
	$diffuseexp "1.5"


	$phong "1"
	$phongexponent "32"
	$phongboost "4"
	$phongfresnelranges "[0.15 0.5 1.0]"

	$envmap "env_cubemap"
	$envmapfresnel "0.7"
	$envmaptint "[0.1 0.1 0.1]"
	$alphatest 1
}
}